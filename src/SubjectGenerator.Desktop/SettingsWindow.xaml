<Window x:Class="SubjectGenerator.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sozlamalar"
        Width="860" Height="600" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F7FA" FontSize="14">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2F5FD0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#244CAB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small grey button inside list rows: "x" to delete, "-" / "+" to change a number. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#5B6B82"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#EEF1F5" CornerRadius="4" Width="28" Height="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#DCE3EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#C9D1DC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6B82"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D1DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource ActionButton}" Content="Yopish" IsCancel="True" Click="OnCloseClick"/>

        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">

            <!-- ===== Classes ===== -->
            <TabItem Header="  Sinflar  ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Maktabdagi sinflar. Masalan: 5-A, 5-B, 6-A."/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                                Content="Qo'shish" Click="OnAddClass"/>
                        <TextBox x:Name="NewClassName" Style="{StaticResource InputBox}" KeyDown="OnAddClassKey"/>
                    </DockPanel>
                    <Border Style="{StaticResource Panel}">
                        <ListBox x:Name="ClassesList" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="✕"
                                                ToolTip="O'chirish" Tag="{Binding}" Click="OnRemoveClass"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ===== Subjects ===== -->
            <TabItem Header="  Fanlar  ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Fanlar va har bir sinfda haftasiga necha marta o'tilishi."/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                                Content="Qo'shish" Click="OnAddSubject"/>
                        <TextBox x:Name="NewSubjectLessons" DockPanel.Dock="Right" Style="{StaticResource InputBox}"
                                 Width="60" Margin="8,0,0,0" Text="2" HorizontalContentAlignment="Center"
                                 KeyDown="OnAddSubjectKey" ToolTip="Haftasiga necha marta"/>
                        <TextBlock DockPanel.Dock="Right" Text="haftasiga:" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="#5B6B82"/>
                        <TextBox x:Name="NewSubjectName" Style="{StaticResource InputBox}" KeyDown="OnAddSubjectKey"/>
                    </DockPanel>
                    <Border Style="{StaticResource Panel}">
                        <ListBox x:Name="SubjectsList" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="✕"
                                                Margin="16,0,0,0" ToolTip="O'chirish" Tag="{Binding}" Click="OnRemoveSubject"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="+"
                                                Tag="{Binding}" Click="OnMoreLessons"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LessonsPerWeek}" Width="34"
                                                   TextAlignment="Center" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="−"
                                                Tag="{Binding}" Click="OnFewerLessons"/>
                                        <TextBlock DockPanel.Dock="Right" Text="haftasiga" Foreground="#5B6B82"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ===== Teachers and what they teach ===== -->
            <TabItem Header="  O'qituvchilar  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: the list of teachers. -->
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                                    Content="Qo'shish" Click="OnAddTeacher"/>
                            <TextBox x:Name="NewTeacherName" Style="{StaticResource InputBox}" KeyDown="OnAddTeacherKey"/>
                        </DockPanel>
                        <Border Style="{StaticResource Panel}">
                            <ListBox x:Name="TeachersList" BorderThickness="0" SelectionChanged="OnTeacherSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="✕"
                                                    ToolTip="O'chirish" Tag="{Binding}" Click="OnRemoveTeacher"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <!-- Right: what the selected teacher teaches. -->
                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14">
                        <Grid>
                            <TextBlock x:Name="NoTeacherSelected" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="Chapdan o'qituvchini tanlang yoki yangisini qo'shing."/>

                            <DockPanel x:Name="TeacherDetails" Visibility="Collapsed">
                                <TextBlock x:Name="TeacherTitle" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold"
                                           Foreground="#25364D"/>

                                <TextBlock DockPanel.Dock="Top" Text="Dam olish kunlari:" FontWeight="SemiBold"
                                           Foreground="#25364D" Margin="0,12,0,2"/>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="Belgilangan kunlarda bu o'qituvchiga dars qo'yilmaydi."/>
                                <WrapPanel x:Name="DayOffCheckboxes" DockPanel.Dock="Top" Margin="0,0,0,8"/>

                                <Border DockPanel.Dock="Top" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Margin="0,4,0,10"/>

                                <TextBlock DockPanel.Dock="Top" Text="Qaysi fanni qaysi sinflarda o'qitadi:" FontWeight="SemiBold"
                                           Foreground="#25364D"/>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,2,0,8"
                                           Text="Fanni tanlang, keyin shu o'qituvchi uni qaysi sinflarda o'qitishini belgilang."/>

                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Fan:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="TeacherSubjectPicker" DisplayMemberPath="Name" Padding="6,5"
                                              SelectionChanged="OnTeacherSubjectSelected"/>
                                </DockPanel>

                                <TextBlock x:Name="ClassCheckboxesHint" DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                           Margin="0,0,0,6"/>
                                <WrapPanel x:Name="ClassCheckboxes" DockPanel.Dock="Top" Margin="0,0,0,14"/>

                                <TextBlock DockPanel.Dock="Top" Text="Hozir o'qitadi:" FontWeight="SemiBold"
                                           Foreground="#25364D" Margin="0,0,0,6"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="TeacherSummary"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
