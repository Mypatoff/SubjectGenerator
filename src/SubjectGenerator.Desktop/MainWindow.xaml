<Window x:Class="SubjectGenerator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubjectGenerator - Dars jadvali"
        Width="1100" Height="720" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontSize="14">

    <Window.Resources>
        <!-- A class in the top row: looks like a button, blue when it is the selected class. -->
        <Style x:Key="ClassChip" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Background="White" BorderBrush="#C9D1DC" BorderThickness="1"
                                CornerRadius="6" Padding="14,6" MinWidth="60" Cursor="Hand">
                            <TextBlock x:Name="Label" Text="{Binding Name}" FontWeight="SemiBold"
                                       Foreground="#25364D" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#E3EAF5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#2F5FD0"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#2F5FD0"/>
                                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Sinflar" FontSize="13" FontWeight="SemiBold"
                   Foreground="#5B6B82" Margin="0,0,0,6"/>

        <ListBox x:Name="ClassList" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource ClassChip}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnClassSelected">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <TextBlock x:Name="ClassTitle" DockPanel.Dock="Top" FontSize="22" FontWeight="Bold"
                   Foreground="#25364D" Margin="0,10,0,10"/>

        <Border Background="White" BorderBrush="#C9D1DC" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <!-- Filled in code, because the number of days and slots comes from WeekLayout. -->
                <Grid x:Name="WeekGrid"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
