<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Timetable.Desktop</RootNamespace>
    <AssemblyName>Timetable</AssemblyName>
    <Product>Timetable</Product>
    <AssemblyTitle>Timetable</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\Timetable.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Timetable.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timetable.Core\Timetable.Core.csproj" />
  </ItemGroup>

</Project>
